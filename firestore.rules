rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Planes y cuota de búsquedas — el usuario LEE su propio entitlement,
    // pero SOLO el Admin SDK (server) puede escribirlo. Evita que el usuario
    // resetee su contador o se auto-asigne un plan desde el cliente.
    match /entitlements/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /analytics/{document=**} {
      allow read, write: if true;
    }

    match /visitors/{document=**} {
      allow read, write: if true;
    }

    match /userVotes/{document=**} {
      allow read, write: if true;
    }

    match /events/{document=**} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    match /pageStats/{document=**} {
      allow read, write: if true;
    }

    match /pageViews/{document=**} {
      allow read, write: if true;
    }

    match /productViews/{viewId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    match /productStats/{productId} {
      allow read, write: if true;
    }

    match /productQuestions/{questionId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.questionAuthorUid == request.auth.uid
        && request.resource.data.answerText == null
        && request.resource.data.isVisible == true
        && request.resource.data.questionText.size() >= 10
        && request.resource.data.questionText.size() <= 500;
      allow update: if true;
      allow delete: if false;
    }

    match /analisis_zonas/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /zonas_analisis/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /proyectos/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /productos_alquiler/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Planes de Lead Finder Pro (ABM desde el admin). Lectura pública para la
    // futura pagina de pricing/checkout; escritura SOLO via Admin SDK (API route
    // con adminPassword), igual que "products".
    match /leadfinder_plans/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Cuota/acceso de Lead Finder Pro por usuario — el usuario LEE su propio estado,
    // pero SOLO el Admin SDK puede escribirlo (mismo patron que "entitlements").
    match /leadfinder_entitlements/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Configuracion editable del menu de navegacion (admin y panel del cliente).
    // Lectura publica (el cliente logueado necesita leer su propio arbol de nav),
    // escritura SOLO via Admin SDK (API route con adminPassword).
    match /nav_config/{tree} {
      allow read: if true;
      allow write: if false;
    }

    // Auditorias ya hechas por cada cliente de Lead Finder Pro -- si ya audito un
    // negocio, no se le vuelve a cobrar credito ni se relanza la llamada a Google.
    // El cliente LEE las suyas, SOLO el Admin SDK escribe (se graba en el server
    // al momento de auditar, ver /api/lead-finder-pro/run).
    match /leadfinder_client_audits/{uid}/audits/{placeId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Historial de búsquedas guardadas por cliente -- Lead Finder Pro y Analítica
    // (Rubros buscados). El cliente LEE las suyas, SOLO el Admin SDK escribe.
    match /leadfinder_searches/{uid}/items/{searchId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /keyword_searches/{uid}/items/{searchId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

  }
}
